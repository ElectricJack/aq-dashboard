{
  "name": "aq-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs dist && node scripts/bundle-manifest.mjs dist",
    "typecheck": "tsc -b",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.8",
    "@tanstack/react-query": "5.105.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "knip": "6.44.2",
    "msw": "3.0.3",
    "ts-morph": "28.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
